[Unit]
Description=Port Grove lightweight server agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/port-grove
EnvironmentFile=/etc/port-grove-agent.env
ExecStart=/usr/bin/python3 /opt/port-grove/agent/agent.py
Restart=on-failure
RestartSec=8
Nice=10
CPUWeight=10
MemoryMax=96M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
